# Managed by Ansible (role cs3_stack). Do not edit by hand.
CS3_PROFILE={{ cs3_profile }}
CS3_CONSOLE_IMAGE={{ cs3_console_image }}
CS3_CONSOLE_PORT={{ cs3_console_port }}
APP_URL={{ cs3_console_url }}
JWT_SECRET={{ vault_jwt_secret }}
CS3_INGEST_REQUIRE_KEY={{ cs3_ingest_require_key | lower }}
POSTGRES_DB=cs3
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ vault_postgres_password }}
CS3_APP_PASSWORD={{ vault_cs3_app_password }}
CS3_MIGRATOR_PASSWORD={{ vault_cs3_migrator_password }}
CS3_ARCHIVER_PASSWORD={{ vault_cs3_archiver_password }}
OLLAMA_PRIMARY_MODEL={{ cs3_ollama_primary_model }}
OLLAMA_FALLBACK_MODEL={{ cs3_ollama_fallback_model }}
OLLAMA_NUM_PARALLEL={{ cs3_ollama_num_parallel }}
OLLAMA_MAX_LOADED_MODELS={{ cs3_ollama_max_loaded_models }}
OLLAMA_KEEP_ALIVE={{ cs3_ollama_keep_alive }}
GEMINI_API_KEY={{ vault_gemini_api_key | default('') if cs3_hosted_models_enabled | bool else '' }}
DEEPSEEK_API_KEY={{ vault_deepseek_api_key | default('') if cs3_hosted_models_enabled | bool else '' }}
OPENSEARCH_JAVA_OPTS={{ cs3_opensearch_java_opts }}
OPENSEARCH_INITIAL_ADMIN_PASSWORD={{ vault_opensearch_admin_password | default('') }}
CS3_INDEXER_ENABLED={{ cs3_indexer_enabled | default(false) | lower }}
CECUR_INDEXER_URL={{ cs3_indexer_url | default('https://indexer:9200') }}
CECUR_INDEXER_USERNAME={{ cs3_indexer_username | default('admin') }}
CECUR_INDEXER_PASSWORD={{ vault_indexer_password | default('') }}
CECUR_INDEXER_TLS_INSECURE={{ cs3_indexer_tls_insecure | default(false) | lower }}
