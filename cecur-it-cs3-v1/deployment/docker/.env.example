# CS3 Docker/Podman Compose environment. Copy to .env (gitignored) and fill in.
# Generate secrets with:  openssl rand -hex 32
CS3_PROFILE=onprem                 # cloud | onprem | airgap
CS3_CONSOLE_IMAGE=ghcr.io/dascient/cs3-soc-console:latest
CS3_CONSOLE_PORT=3000
APP_URL=https://soc.example.internal

JWT_SECRET=
CS3_INGEST_REQUIRE_KEY=true        # enforce per-agent X-API-Key on /api/cecur/logs/ingest

# --- PostgreSQL (JSONB persistence) ---
POSTGRES_DB=cs3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
CS3_APP_PASSWORD=
CS3_MIGRATOR_PASSWORD=
CS3_ARCHIVER_PASSWORD=

# --- Ollama (multi-node behind NGINX) ---
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PRIMARY_MODEL=nemotron-3-nano:30b
OLLAMA_FALLBACK_MODEL=gemma4:26b
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m

# --- Hosted-model keys: MUST stay blank on onprem/airgap ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- SIEM indexer (profile "siem") ---
CECUR_INDEXER_URL=https://indexer:9200
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Durable log indexing in the console: set "true" only when running with
# `--profile siem` (see docker/README.md). CECUR_INDEXER_PASSWORD should match
# OPENSEARCH_INITIAL_ADMIN_PASSWORD above.
CS3_INDEXER_ENABLED=false
CECUR_INDEXER_USERNAME=admin
CECUR_INDEXER_PASSWORD=
CECUR_INDEXER_TLS_INSECURE=false
