[Unit]
Description=Cecur CS3 log forwarder (Fluent Bit)
Documentation=https://github.com/cecur-it/cecur-it-cs3/blob/main/deployment/agents/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=/etc/cecur/forwarder.env
ExecStart=/opt/fluent-bit/bin/fluent-bit -c /etc/cecur/fluent-bit.conf
Restart=always
RestartSec=5
# Journal + auth logs need read access; no write access anywhere except the buffer.
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/cecur-forwarder
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
