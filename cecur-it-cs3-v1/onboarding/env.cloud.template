# CS3 Platform — cloud (PaaS) environment
# Generated by onboarding/wizard.mjs from onboarding/env.cloud.template
# DO NOT commit a populated copy of this file. .env is gitignored by default.

CS3_PROFILE=cloud
CS3_LLM_MODE=hosted

# --- CS3 Cloud tenant identifiers (prompted by the wizard) ---
CS3_TENANT_ID=
CS3_TENANT_REGION=us-east

# --- Hosted model provider keys (prompted by the wizard; required, non-blank) ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- SOC Console container ---
CS3_CONSOLE_IMAGE=ghcr.io/dascient/cs3-soc-console:latest
CS3_CONSOLE_PORT=3000

# --- Telemetry / update checks are ALLOWED on this profile ---
CS3_TELEMETRY_ENABLED=true
CS3_UPDATE_CHECK_ENABLED=true

# The following variables are meaningless on this profile and MUST stay unset.
# The wizard and cs3-launcher.mjs actively refuse to start if any are non-empty:
#   OLLAMA_BASE_URL, CS3_AIRGAP_BUNDLE_SHA256, CS3_AIRGAP_BUNDLE_TAG

# --- Console runtime (demo/demo-100226) ---
# JWT_SECRET is auto-generated by onboarding/wizard.mjs when blank.
JWT_SECRET=
APP_URL=http://localhost:3000
ERROW_BASE_URL=http://127.0.0.1:8088
ERROW_API_KEY=
ERROW_MODE=remote
ERROW_SANDBOX_RUNTIME=docker
CECUR_INDEXER_URL=http://127.0.0.1:9200
CECUR_CLUSTER_NAME=cecur-prod-cluster
# Optional Firestore overrides (defaults: demo/demo-100226/firebase-applet-config.json)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
