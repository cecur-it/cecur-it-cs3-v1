# CS3 Platform — airgap (fully disconnected) environment
# Generated by onboarding/wizard.mjs from onboarding/env.airgap.template
# DO NOT commit a populated copy of this file. .env is gitignored by default.

CS3_PROFILE=airgap
CS3_LLM_MODE=local

# --- Local Ollama endpoint (OpenAI-compatible), bound to loopback only ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_PRIMARY_MODEL=nemotron-3-nano:30b
OLLAMA_FALLBACK_MODEL=gemma4:26b

# --- Hosted model provider keys are FORBIDDEN on this profile: left blank on purpose ---
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Verified bundle metadata, written by scripts/verify-bundle.mjs on a PASS result ---
# cs3-launcher.mjs refuses to proceed if these are empty or do not match the bundle
# that was just re-verified at launch time.
CS3_AIRGAP_BUNDLE_SHA256=
CS3_AIRGAP_BUNDLE_TAG=

# --- SOC Console container: loaded from an offline image tar, never pulled from a registry ---
CS3_CONSOLE_IMAGE=cs3-soc-console:airgap
CS3_CONSOLE_PORT=3000

# --- Telemetry / update checks are DISABLED and enforced disabled on this profile ---
CS3_TELEMETRY_ENABLED=false
CS3_UPDATE_CHECK_ENABLED=false

# --- Console runtime (demo/demo-100226) ---
# JWT_SECRET is auto-generated by onboarding/wizard.mjs when blank.
JWT_SECRET=
APP_URL=http://localhost:3000
HEXSTRIKE_BASE_URL=http://127.0.0.1:8888
HEXSTRIKE_API_KEY=
CECUR_INDEXER_URL=http://127.0.0.1:9200
CECUR_CLUSTER_NAME=cecur-prod-cluster
# Firestore sync needs external egress and is unavailable on airgap; the console falls back to its in-memory store.

# --- Durable SIEM log indexing (OpenSearch / Wazuh Indexer, compose profile "siem") ---
# Set to "true" only once the indexer is actually running, or /api/cecur/logs/ingest
# will accept and keep events in the bounded in-memory hot cache but will not persist
# them durably (see deployment/operations/opensearch-cluster.md and on-prem/).
CS3_INDEXER_ENABLED=false
CECUR_INDEXER_USERNAME=admin
CECUR_INDEXER_PASSWORD=
# OpenSearch 2.x enables the security plugin (HTTPS + self-signed cert) by default.
# Keep this "false" in production once a real CA-issued cert is installed.
CECUR_INDEXER_TLS_INSECURE=false

# Durable storage (requires DATABASE_URL)
CS3_PERSISTENCE=postgres
