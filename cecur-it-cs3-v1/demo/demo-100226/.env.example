# CS3 / CECUR-IT Unified SOC Console — environment template.
# Copy to .env (gitignored) for local `npm run dev`. For Docker / cloud /
# onprem / airgap installs, use `node cs3-launcher.mjs --profile <profile>`
# from the repository root instead; it generates .env from onboarding/env.*.template.
# NEVER commit real keys here.

# CS3_DEMO_MODE: set to "true" ONLY for demos. Enables the mock telemetry simulation loop and
# seeds demonstrative credentials into Firestore. Leave unset/false for production profiles.
CS3_DEMO_MODE="false"

# Server listen port (default 3000)
PORT="3000"

# GEMINI_API_KEY: CS3 AI Flash. Required on the cloud profile; leave blank on onprem/airgap.
GEMINI_API_KEY=""

# DEEPSEEK_API_KEY: CS3 AI Chat (optional secondary model). Leave blank on onprem/airgap.
DEEPSEEK_API_KEY=""

# APP_URL: URL where this console is hosted (self links, OAuth callbacks).
APP_URL="http://localhost:3000"

# JWT_SECRET: signs auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=""

# FIREBASE (optional). Configure explicitly on cloud and onprem; airgap never uses Firebase.
FIREBASE_API_KEY=""
VITE_FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
VITE_FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_AUTH_DOMAIN=""
FIREBASE_DATABASE_ID=""
VITE_FIREBASE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""

# HexStrike AI server (optional live connector)
HEXSTRIKE_BASE_URL="http://127.0.0.1:8888"
HEXSTRIKE_API_KEY=""

# Cecur open-source SIEM & XDR (optional external indexer)
CECUR_INDEXER_URL="https://127.0.0.1:9200"
CECUR_CLUSTER_NAME="cecur-prod-cluster"

# Durable log indexing: off by default (events stay in the 300-row in-memory hot
# cache). Set "true" once an OpenSearch/Wazuh Indexer is running and reachable at
# CECUR_INDEXER_URL (deployment/operations/opensearch-cluster.md, on-prem/).
CS3_INDEXER_ENABLED="false"
CECUR_INDEXER_USERNAME="admin"
CECUR_INDEXER_PASSWORD=""
CECUR_INDEXER_TLS_INSECURE="false"
